# Foundry
cache/
out/
broadcast/

# Node
node_modules/

# Local secrets and local chain state. A wallet key must never become a tracked
# file; scripts/check-public.sh fails the build if one ever does.
.env
.env.*
!.env.example
*.key
*.pem
wallet.json
deployments/31337.json
deployments/*.local.json
anvil.log

# Agent/workflow working state. Plans, buildouts, specs and session notes are how the work gets done; they are
# not the product and they never belong in a public repo. scripts/check-public.sh fails if one is ever tracked.
docs/plans/
docs/builds/
docs/prd/
docs/reports/
.annotations/
.pilot/
.claude/
CLAUDE.md
AGENTS.local.md

# Misc
.DS_Store
*.log
