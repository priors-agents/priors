# cp .env.example .env   — .env is gitignored and must stay that way.
# None of this is needed for `npm run quickstart`: a local chain derives its own throwaway wallet.

# The chain to talk to. Local dev chain by default.
RPC_URL=http://127.0.0.1:8545
# Robinhood Chain testnet (id 46630): https://rpc.testnet.chain.robinhood.com
#
# RPC_URL takes a COMMA-SEPARATED LIST, tried in order: the first entry first, the next only when that
# one fails or refuses. Worth using on mainnet — the official endpoint rate-limits under load, and these
# three all answered eth_chainId for chain 4663 when this was written:
#
#   RPC_URL=https://rpc.mainnet.chain.robinhood.com,https://robinhood-rpc.publicnode.com,https://rpc.ordofi.network
#
# One caveat that will bite you if nobody says it: only the FIRST of those serves a deep `eth_getLogs`.
# publicnode answers 403 "Archive requests require a personal token" and ordofi answers -32005 "the
# network is busy", so event-history reads need the official endpoint reachable. Plain calls are fine on
# any of them, which is what the other two are for.

# The wallet that owns (or will own) your ERC-8004 identity. It needs native gas, and USDG to cover loan fees.
PRIVATE_KEY=0x
# The v2 CLI (`npx priors-v2`) reads PRIORS_KEY, and falls back to PRIVATE_KEY. Its RPC defaults to Robinhood
# Chain mainnet (not localhost) and its addresses to deployments/<chainId>.v2.json; PRIORS_ADDRESSES overrides them.
# PRIORS_KEY=0x
# PRIORS_AGENT_ID=     only for an identity minted before the v2 deploy, or when the key owns several

# v1 only: override deployments/<chainId>.json — e.g. to point at a pool that has no committed record.
# POOL=0x
# TREASURY=0x
# USDC=0x
